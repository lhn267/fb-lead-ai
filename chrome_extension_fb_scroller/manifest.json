{
  "manifest_version": 3,
  "name": "FB Auto-Scroller & Lead Extractor",
  "version": "1.0",
  "description": "Tự động cuộn trang bạn bè Facebook và tải danh sách Excel/CSV an toàn, chống checkpoint.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://*.facebook.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
